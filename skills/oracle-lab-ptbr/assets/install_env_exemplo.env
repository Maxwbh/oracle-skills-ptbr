# install_env_exemplo.env — Suíte Oracle PT-BR / oracle-lab-ptbr
# Modelo comentado do config/install.env dos builds oracle-base (vagrant/database/*).
# Copie sobre o install.env da pasta escolhida e ajuste. Valores aqui são de LABORATÓRIO.
# Versão de referência: build ol9_26_free (Oracle AI Database 26ai Free em Oracle Linux 9).

# --- Banco -------------------------------------------------------------------
export DB_PASSWORD=SysPassword1          # senha de SYS e SYSTEM. Troque se a VM for ficar em bridge.
export SYS_PASSWORD=${DB_PASSWORD}
export ORACLE_SID=FREE                   # no 26ai Free é sempre FREE; no 19c costuma ser cdb1
export PDB_NAME=freepdb1                 # <<< é ESTE nome que você usa para conectar (service name)
# Atenção: a edição Free limita o BANCO a 2 GB de RAM, 2 cores e 12 GB de dados,
# não importa quanta memória a VM tenha. O APEX 26.1 exige SGA >= 1200 MB e PGA >= 300 MB,
# o que cabe nesses 2 GB, mas sem folga.

export ORACLE_BASE=/opt/oracle
export ORACLE_HOME=/opt/oracle/product/26ai/dbhomeFree
export ORA_INVENTORY=/opt/oracle/oraInventory
export DATA_DIR=/opt/oracle/oradata
export SCRIPTS_DIR=/home/oracle/scripts
export PATH=$ORACLE_HOME/bin:$PATH

# Nome EXATO do arquivo que você colocou em software/ — confira antes do vagrant up.
export DB_SOFTWARE=oracle-ai-database-free-26ai-23.26.0-1.el9.x86_64.rpm

# --- O que instalar ----------------------------------------------------------
# Só quer um banco para escrever SQL? Ponha os dois como false:
# a instalação cai de ~50 para ~15 minutos e economiza cerca de 2 GB de RAM.
export INSTALL_APEX=true
export INSTALL_ORDS="true"

# --- APEX --------------------------------------------------------------------
export APEX_SOFTWARE="apex_26.1_en.zip"  # APEX 26.1 exige ORDS >= 26.1.1 e, em 26ai, banco >= 23.26.0
export APEX_EMAIL="me@example.com"       # e-mail do ADMIN do workspace INTERNAL
export APEX_PASSWORD="ApexPassword1"     # senha do ADMIN — usada no primeiro login
export APEX_TABLESPACE="APEX"
export TEMP_TABLESPACE="TEMP"
export APEX_PUBLIC_USER_PASSWORD="ApexPassword1"
export APEX_LISTENER_PASSWORD="ApexPassword1"
export APEX_REST_PASSWORD="ApexPassword1"
export PUBLIC_PASSWORD="ApexPassword1"

# --- ORDS / Tomcat / Java ----------------------------------------------------
# ORDS 26.1 aceita Oracle JDK 17/21 OU GraalVM 17/21. GraalVM só é obrigatório para GraphQL.
export JAVA_SOFTWARE="graalvm-jdk-21_linux-x64_bin.tar.gz"

# Série 9 obrigatória: ORDS 26.1 suporta Tomcat 9.0.x. Tomcat 10 só a partir do ORDS 26.4
# (inverno/2026) — a Oracle pede explicitamente para não antecipar a migração.
export TOMCAT_SOFTWARE="apache-tomcat-9.0.110.tar.gz"

# A Oracle publica o arquivo como "ords-latest.zip" e o conteúdo muda a cada release.
# Para o lab ser reproduzível, RENOMEIE o download e fixe a versão aqui.
# O APEX 26.1 exige ORDS >= 26.1.1.
export ORDS_VERSION="26.1.1"
export ORDS_SOFTWARE="ords-${ORDS_VERSION}.zip"
export SQLCL_SOFTWARE="sqlcl-latest.zip"
export SOFTWARE_DIR="/u01/software"
export ORDS_HOME="/u01/ords"
export ORDS_CONF="/u01/config/ords"
export JAVA_HOME="/u01/java/latest"
export CATALINA_HOME="/u01/tomcat/latest"
export CATALINA_BASE="/u01/config/instance1"
export ORDS_PASSWORD=${APEX_LISTENER_PASSWORD}

# --- Conexão e HTTPS ---------------------------------------------------------
export DB_PORT="1521"
export DB_SERVICE=${PDB_NAME}
export KEYSTORE_DIR="/u01/keystore"
export KEYSTORE_PASSWORD="KeystorePassword1"   # certificado autoassinado: o aviso do navegador é esperado
export AJP_SECRET="AJPSecret1"
export AJP_ADDRESS="::1"

# --- Para 19c em vez de 26ai Free --------------------------------------------
# Use a pasta ol9_19 (ou ol8_19) e troque as linhas de banco por:
#   export ORACLE_BASE=/u01/app/oracle
#   export ORACLE_HOME=${ORACLE_BASE}/product/19.0.0/dbhome_1
#   export ORACLE_SID=cdb1
#   export PDB_NAME=pdb1
#   export PDB_PASSWORD="PdbPassword1"
#   export DB_SOFTWARE="LINUX.X64_193000_db_home.zip"   # exige conta no edelivery.oracle.com
#   export PATCH_DB="false"                              # patches exigem My Oracle Support
